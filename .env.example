# Linear OAuth (primary connection method)
# Create a Linear OAuth app at https://linear.app/settings/api/applications
# Callback URL: your deployed URL (or http://localhost:5173 for local dev)
VITE_LINEAR_CLIENT_ID=your_linear_client_id_here

# URL of the Cloudflare Worker that exchanges the OAuth code for a token.
# Run `npx wrangler dev` in worker/ for local dev (serves on http://localhost:8787).
# The worker holds LINEAR_CLIENT_SECRET — see worker/.dev.vars.example.
VITE_LINEAR_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Optional: skip OAuth and bake in a Linear personal API key.
# When set, the app connects on load without showing the setup screen.
# LINEAR_API_TOKEN=lin_api_xxx
